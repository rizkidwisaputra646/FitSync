rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role check: Memeriksa apakah caller adalah staf / admin
    function isStaffOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'staff' ||
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid)) ||
        // Fallback untuk akun testing / portal admin
        request.auth.token.email.matches('.*admin.*')
      );
    }

    // 1. Koleksi Profil Pengguna & Subkoleksinya
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isStaffOrAdmin();

      match /membership/{membershipId} {
        allow read, write: if isOwner(userId) || isStaffOrAdmin();
      }

      match /checkin_history/{checkinId} {
        allow read, write: if isOwner(userId) || isStaffOrAdmin();
      }

      match /weightLogs/{logId} {
        allow read, write: if isOwner(userId);
      }

      match /workoutSessions/{sessionId} {
        allow read, write: if isOwner(userId) || isStaffOrAdmin();
      }

      match /customizedPrograms/{allPaths=**} {
        allow read, write: if isOwner(userId) || isStaffOrAdmin();
      }

      // Akses wildcard untuk seluruh subkoleksi user
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isStaffOrAdmin();
      }
    }

    // 2. Koleksi Token QR Aktif (Realtime Anti-Fraud & Anti-Replay)
    match /active_qr_tokens/{userId} {
      // Member hanya bisa membaca token miliknya sendiri. Staf/turnstile bisa membaca untuk verifikasi.
      allow read: if isOwner(userId) || isStaffOrAdmin();

      // MEMBER HANYA BISA CREATE / UPDATE DENGAN STATUS used == false
      // Member DILARANG memanipulasi used: true, usedAt, atau expiresAt ke masa depan
      allow create, update: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.used == false &&
        request.resource.data.status == 'active';

      // STAF / TURNSTILE DI-IZINKAN MENGUNCI TOKEN (used: true) DALAM TRANSAKSI ATOMIK
      allow update: if isAuthenticated() &&
        request.resource.data.used == true;
    }

    // 3. Koleksi Check-in Global Monitoring
    match /checkins/{checkinId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Koleksi Paket Membership & Latihan Umum
    match /membership_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrAdmin();
    }

    match /exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrAdmin();
    }
  }
}
